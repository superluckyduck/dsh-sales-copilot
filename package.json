{
  "name": "dsh-sales-copilot",
  "version": "0.3.3",
  "description": "开箱即用的中英双语销售助手：FAQ 快查、实时通话辅助、语音对练、通话纪要和客户画像",
  "private": false,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./plugins/dsh-sales-copilot/index.js",
    "./client": "./plugins/dsh-sales-copilot/client.js",
    "./locale/*.json": "./plugins/dsh-sales-copilot/locale/*.json",
    "./icon": "./plugins/dsh-sales-copilot/icon.svg"
  },
  "files": [
    "plugins/dsh-sales-copilot",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots"]
    }
  },
  "engines": { "node": ">=20", "dsh": ">=0.2.0" },
  "dependencies": {
    "dsh-live-captions": "^1.1.1"
  }
}

