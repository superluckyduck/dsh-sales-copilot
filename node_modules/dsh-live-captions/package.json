{
  "name": "dsh-live-captions",
  "version": "1.1.1",
  "description": "Live multilingual captions in DeepSeek Harness: local SenseVoice recognition of system audio and the microphone, per-line translation, a system always-on-top caption overlay, and one-click meeting minutes. Windows x64 and macOS (Apple Silicon/Intel).",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "flashvayne",
    "email": "flashvayne@gmail.com"
  },
  "homepage": "https://github.com/flashvayne/dsh-live-captions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashvayne/dsh-live-captions.git"
  },
  "bugs": {
    "url": "https://github.com/flashvayne/dsh-live-captions/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subtitles",
    "captions",
    "live-captions",
    "speech-to-text",
    "translation",
    "meeting-minutes",
    "sensevoice",
    "wasapi"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "native",
    "locale/*.json",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-api-session-controller"]
    }
  }
}
